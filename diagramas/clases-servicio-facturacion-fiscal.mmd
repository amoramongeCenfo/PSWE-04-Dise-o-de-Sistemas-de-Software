%% Figura 14 - Diagrama de clases de diseno: Servicio de Facturacion Fiscal (Componente 1)
%% SmartBilling Connect - PSWE-04 - Entrega final (S14)
classDiagram
    direction TB

    class FiscalInvoiceController {
        <<boundary>>
        -IFiscalInvoiceService _service
        -ITenantContext _tenant
        +EmitirAsync(ComprobanteRequest request, CancellationToken ct) Task~IActionResult~
        +ConsultarEstadoAsync(Guid comprobanteId) Task~IActionResult~
    }

    class FiscalEventConsumer {
        <<boundary>>
        -IFiscalInvoiceService _service
        +ConsumirAsync(EmitirComprobanteEvent evento, CancellationToken ct) Task
        -MapearARequest(EmitirComprobanteEvent evento) ComprobanteRequest
    }

    class IFiscalInvoiceService {
        <<interface>>
        +EmitirComprobanteAsync(ComprobanteRequest request, CancellationToken ct) Task~ComprobanteResult~
        +ConsultarEstadoAsync(Guid comprobanteId, Guid tenantId) Task~ComprobanteStatusDto~
        +RegistrarRespuestaHaciendaAsync(Guid comprobanteId, HaciendaResponse respuesta) Task
    }

    class FiscalInvoiceService {
        <<control>>
        -IXmlComprobanteBuilderResolver _resolverBuilder
        -ISignatureProvider _firmador
        -IHaciendaClient _hacienda
        -IComprobanteRepository _repo
        -IOutboxWriter _outbox
        -IDocumentArchive _archivo
        -IdempotencyGuard _idempotencia
        -ComprobanteStateMachine _maquinaEstados
        +EmitirComprobanteAsync(ComprobanteRequest request, CancellationToken ct) Task~ComprobanteResult~
        +ConsultarEstadoAsync(Guid comprobanteId, Guid tenantId) Task~ComprobanteStatusDto~
        +RegistrarRespuestaHaciendaAsync(Guid comprobanteId, HaciendaResponse respuesta) Task
        -ValidarRequest(ComprobanteRequest request) void
    }

    class ComprobanteStateMachine {
        <<control>>
        -Dictionary~TransicionKey, ComprobanteEstado~ _transiciones
        +Transicionar(ComprobanteEstado actual, ComprobanteEvento evento) ComprobanteEstado
        +EsTransicionValida(ComprobanteEstado actual, ComprobanteEvento evento) bool
    }

    class IdempotencyGuard {
        <<control>>
        -IProcessedEventStore _store
        +TryBeginAsync(Guid eventId, Guid tenantId) Task~bool~
        +ObtenerResultadoPrevioAsync(Guid eventId) Task~ComprobanteResult~
    }

    class IXmlComprobanteBuilderResolver {
        <<interface>>
        +Resolver(string versionEsquema) IXmlComprobanteBuilder
    }
    class XmlBuilderResolver {
        -IEnumerable~IXmlComprobanteBuilder~ _builders
        +Resolver(string versionEsquema) IXmlComprobanteBuilder
    }

    class IXmlComprobanteBuilder {
        <<interface>>
        +Version() string
        +ConstruirXml(ComprobanteRequest request) string
    }
    class XmlComprobanteBuilderV43 {
        +Version() string
        +ConstruirXml(ComprobanteRequest request) string
    }
    class XmlComprobanteBuilderV44 {
        +Version() string
        +ConstruirXml(ComprobanteRequest request) string
    }

    class ISignatureProvider {
        <<interface>>
        +Firmar(string xmlContent, X509Certificate2 certificado) XmlFirmado
    }
    class XadesEpesSignatureProvider {
        +Firmar(string xmlContent, X509Certificate2 certificado) XmlFirmado
    }

    class IHaciendaClient {
        <<interface>>
        +EnviarComprobanteAsync(XmlFirmado xmlFirmado, CancellationToken ct) Task~HaciendaResponse~
        +ConsultarEstadoAsync(string claveNumerica, CancellationToken ct) Task~HaciendaResponse~
    }
    class HaciendaHttpClient {
        -HttpClient _http
        -IAsyncPolicy _resiliencia
        +EnviarComprobanteAsync(XmlFirmado xmlFirmado, CancellationToken ct) Task~HaciendaResponse~
        +ConsultarEstadoAsync(string claveNumerica, CancellationToken ct) Task~HaciendaResponse~
    }

    class IComprobanteRepository {
        <<interface>>
        +ObtenerAsync(Guid comprobanteId, Guid tenantId) Task~Comprobante~
        +GuardarAsync(Comprobante comprobante, byte[] rowVersion) Task
    }
    class ComprobanteSqlRepository {
        -SqlConnection _conexion
        -ITenantContext _tenant
        +ObtenerAsync(Guid comprobanteId, Guid tenantId) Task~Comprobante~
        +GuardarAsync(Comprobante comprobante, byte[] rowVersion) Task
    }

    class IOutboxWriter {
        <<interface>>
        +EscribirEnTransaccionAsync(OutboxMessage mensaje, IDbTransaction tx) Task
    }
    class OutboxWriter {
        +EscribirEnTransaccionAsync(OutboxMessage mensaje, IDbTransaction tx) Task
    }

    class IDocumentArchive {
        <<interface>>
        +ArchivarAsync(string claveNumerica, XmlFirmado documento) Task~string~
    }

    class Comprobante {
        <<entity>>
        +Guid Id
        +Guid TenantId
        +string ClaveNumerica
        +ComprobanteEstado Estado
        +string HashXml
        +DateTime FechaEmision
        +byte[] RowVersion
        +AplicarEstado(ComprobanteEstado nuevo) void
    }

    class ComprobanteEstado {
        <<enumeration>>
        Generado
        Firmado
        Enviado
        PendienteValidacionHacienda
        Aceptado
        Rechazado
    }

    FiscalInvoiceController ..> IFiscalInvoiceService : usa
    FiscalEventConsumer ..> IFiscalInvoiceService : usa
    FiscalInvoiceService ..|> IFiscalInvoiceService
    FiscalInvoiceService --> ComprobanteStateMachine
    FiscalInvoiceService --> IdempotencyGuard
    FiscalInvoiceService ..> IXmlComprobanteBuilderResolver
    FiscalInvoiceService ..> ISignatureProvider
    FiscalInvoiceService ..> IHaciendaClient
    FiscalInvoiceService ..> IComprobanteRepository
    FiscalInvoiceService ..> IOutboxWriter
    FiscalInvoiceService ..> IDocumentArchive
    XmlBuilderResolver ..|> IXmlComprobanteBuilderResolver
    XmlBuilderResolver ..> IXmlComprobanteBuilder : selecciona por version
    XmlComprobanteBuilderV43 ..|> IXmlComprobanteBuilder
    XmlComprobanteBuilderV44 ..|> IXmlComprobanteBuilder
    XadesEpesSignatureProvider ..|> ISignatureProvider
    HaciendaHttpClient ..|> IHaciendaClient
    ComprobanteSqlRepository ..|> IComprobanteRepository
    OutboxWriter ..|> IOutboxWriter
    IComprobanteRepository ..> Comprobante
    Comprobante --> ComprobanteEstado
