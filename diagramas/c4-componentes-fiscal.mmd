    classDef ext fill:#e2e3e5,stroke:#6c757d,color:#212529;
    classDef store fill:#fde8cd,stroke:#cc7a00,color:#5a3600;
    class CTRL,AMQP,HCLI boundary;
    class SVC,SM,IDEMP,XML,SIGN control;
    class REPO,OUT entity;
    class API,HAC,BROKER ext;
    class DBTX,DOCS store;
